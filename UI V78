                    fpart(6, 47, 58, 3, GOLD, nil, 4)

                    return flyer, legs, glow, scale
                end

                fly = function()
                    if flying then return end
                    flying = true

                    local vp = Camera.ViewportSize
                    local dir = (rng:NextNumber() < 0.5) and 1 or -1
                    local flyer, legs, glow, scale = buildFlyer(dir)
                    local baseY = rng:NextNumber(0.18, 0.7) * vp.Y
                    local amp = rng:NextNumber(25, 55)
                    local span = vp.X + 440
                    local duration = rng:NextNumber(6.5, 8.5)
                    local elapsed, nextSpark, nextGift = 0, 0, 0.8

                    say("Look up!", 2)
                    task.spawn(wave)

                    while elapsed < duration and Win.Parent do
                        local dt = RunService.Heartbeat:Wait()
                        elapsed += dt
                        local t = math.min(elapsed / duration, 1)
                        local x = (dir == 1) and (-220 + span * t) or (vp.X + 220 - span * t)
                        local y = baseY + math.sin(t * math.pi * 2) * amp
                        local slope = amp * math.pi * 2 * math.cos(t * math.pi * 2) / span

                        flyer.Position = dim_offset(x, y)
                        flyer.Rotation = math.deg(math.atan(slope)) * dir

                        for _, l in legs do
                            l.obj.Rotation = math.sin(elapsed * 14 + l.phase) * 28
                        end

                        if glow then
                            glow.BackgroundTransparency = 0.55 + 0.25 * math.sin(elapsed * 9)
                        end

                        if elapsed >= nextSpark then
                            nextSpark = elapsed + 0.04
                            spark(x - dir * 95 * scale, y + 10 * scale)
                        end

                        if elapsed >= nextGift then
                            nextGift = elapsed + 1.3
                            dropGift(x - dir * 40 * scale, y + 20 * scale)
                        end
                    end

                    flyer:Destroy()
                    flying = false
                end

                task.spawn(function()
                    task.wait(rng:NextNumber(10, 16))
                    while Win.Parent do
                        if Win.Visible and not window.Tweening and not flying then
                            fly()
                        end
                        task.wait(rng:NextNumber(25, 45))
                    end
                end)

                Notifications:Create({Name = "Merry Christmas! Festive theme loaded"})
            end)

            if not ok then
                warn("[Christmas theme] decoration skipped: " .. tostring(err))
            end
        end
