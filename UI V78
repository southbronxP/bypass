        function Library:ChristmasDecorate(window)
            if Library.Christmas == false then return end

            local ok, err = pcall(function()
                local Items = window.Items
                local Win = Items.Window
                local rng = Random.new()
                local RED, GREEN, GOLD, BLUE = rgb(230, 57, 70), rgb(46, 204, 113), rgb(255, 209, 102), rgb(72, 149, 239)
                local font = Font.new("rbxassetid://12187365364", Enum.FontWeight.Medium, Enum.FontStyle.Normal)

                if Items.SectionTitle and window.Prefix == "inferno." then
                    Items.SectionTitle.Text = '<font color="rgb(255,255,255)">christmas.</font>update'
                end

                if Items.TitleHolder then
                    local cane = Library:Create("Frame", {
                        Parent = Items.TitleHolder; Name = "\0";
                        Position = dim2(0, 0, 1, -4); Size = dim2(1, 0, 0, 4);
                        BorderSizePixel = 0; ZIndex = 5; BackgroundColor3 = rgb(255, 255, 255);
                    })
                    local keys, stripes = {}, 9
                    for s = 0, stripes - 1 do
                        local c = (s % 2 == 0) and RED or rgb(255, 255, 255)
                        keys[#keys + 1] = rgbkey(s / stripes, c)
                        keys[#keys + 1] = rgbkey((s + 1) / stripes - 0.0001, c)
                    end
                    keys[#keys + 1] = rgbkey(1, RED)
                    Library:Create("UIGradient", {Parent = cane; Color = rgbseq(keys)})

                    local countdown = Library:Create("TextLabel", {
                        Parent = Items.TitleHolder; Name = "\0"; BackgroundTransparency = 1;
                        AnchorPoint = vec2(1, 0.5); Position = dim2(1, -12, 0.5, 0);
                        AutomaticSize = Enum.AutomaticSize.XY; TextSize = 13; ZIndex = 2;
                        TextColor3 = themes.preset.text_color; FontFace = font; Text = "";
                    }); Library:Themify(countdown, "text_color", "TextColor3")

                    local function refresh()
                        local now = os.time()
                        local d = os.date("*t", now)
                        if d.month == 12 and d.day == 25 then
                            countdown.Text = "Merry Christmas!"
                            return
                        end
                        local target = os.time({year = d.year, month = 12, day = 25, hour = 0})
                        if target <= now then
                            target = os.time({year = d.year + 1, month = 12, day = 25, hour = 0})
                        end
                        local days = math.ceil((target - now) / 86400)
                        countdown.Text = days .. (days == 1 and " day" or " days") .. " until Christmas"
                    end

                    task.spawn(function()
                        while Win.Parent do
                            refresh()
                            task.wait(60)
                        end
                    end)
                end

                local strand = Library:Create("Frame", {
                    Parent = Win; Name = "\0"; BackgroundTransparency = 1;
